# Deploye vers /etc/default/nas-notify (chmod 600, root).

# Token du bot : portail developpeur Discord > Application > Bot > Reset Token.
DISCORD_TOKEN=

# Identifiant Discord du destinataire des messages prives.
# L'obtenir en activant le mode developpeur, puis clic droit sur son profil.
OWNER_ID=

# Notifications en attente de reemission.
SPOOL_DIR=/var/spool/nas-notify
