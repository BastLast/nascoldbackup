[Unit]
Description=Controles de maintenance du NAS
After=network-online.target
Wants=network-online.target
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/nas-alert-maintenance
# Le controle des points de montage monte / en bind : incompatible avec un
# espace de montage prive ou une racine en lecture seule.
PrivateMounts=no
