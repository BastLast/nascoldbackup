#!/usr/bin/env python3
"""Examen quotidien des incidents du NAS.

Trois responsabilites, dans cet ordre :

1. **Cloture** des causes qui ne se manifestent plus : au-dela de RESOLVED_AFTER
   sans nouvelle occurrence, l'incident est tenu pour resolu. Sans cela un
   probleme regle continuerait a peser sur les recapitulatifs, et finirait meme
   par escalader tout seul.

2. **Escalade par persistance** : un `warning` encore actif dont la premiere
   occurrence remonte a plus de ESCALATE_AFTER devient urgent et part
   immediatement. La duree prime sur le nombre d'occurrences -- un echec toutes
   les 5 min pendant une heure en produit 12 mais peut deja etre resolu, tandis
   qu'un echec quotidien pendant dix jours n'en produit que 10 et revele un
   probleme installe.

3. **Recapitulatif periodique**, emis uniquement s'il reste quelque chose a
   signaler. Tout va bien = aucun message.
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
import time
from collections import OrderedDict
from dataclasses import dataclass, field

STATE_DIR = "/var/lib/nas-alerts"
JOURNAL = os.path.join(STATE_DIR, "pending.tsv")
ESCALATED = os.path.join(STATE_DIR, "escalated.json")
LAST_DIGEST = os.path.join(STATE_DIR, "last-digest")

DAY = 86400
RESOLVED_AFTER = 3 * DAY
ESCALATE_AFTER = 7 * DAY
# Un probleme installe ne merite pas un rappel quotidien. L'intervalle entre
# deux relances double a chaque fois : insistant d'abord, puis on considere que
# le message est passe. Sans ce recul, une anomalie non traitee produirait un
# rappel toutes les semaines indefiniment -- 23 messages en 200 jours, mesure.
ESCALATION_COOLDOWN = 7 * DAY
ESCALATION_COOLDOWN_MAX = 30 * DAY
DIGEST_INTERVAL = 30 * DAY
JOURNAL_RETENTION = 90 * DAY
MAX_FIELDS = 20

LEVEL_ORDER = {"info": 0, "warning": 1, "critical": 2}

# La description d'un embed accepte le markdown : une liste hierarchisee y est
# bien plus lisible qu'une grille de champs "inline", qui se tasse sur trois
# colonnes et noie l'essentiel sous les details techniques.
LEVEL_MARK = {"info": "·", "warning": "▸", "critical": "▸"}
DESCRIPTION_LIMIT = 3800


@dataclass
class Incident:
    key: str
    level: str = "info"
    title: str = ""
    detail: str = ""
    count: int = 0
    first_seen: int = 0
    last_seen: int = 0
    timestamps: list[int] = field(default_factory=list)

    @property
    def duration_days(self) -> int:
        return (self.last_seen - self.first_seen) // DAY

    def active(self, now: int) -> bool:
        return now - self.last_seen <= RESOLVED_AFTER


def notify(
    level: str,
    title: str,
    description: str,
    fields: list[tuple[str, str]] | None = None,
) -> None:
    command = [
        "/usr/local/bin/nas-notify",
        "--level", level,
        "--title", title,
        "--description", description[:DESCRIPTION_LIMIT],
        "--source", "surveillance",
    ]
    for name, value in fields or []:
        command += ["--field", f"{name}={value}"]
    subprocess.run(command, check=False)


def human_delay(seconds: int) -> str:
    if seconds < 3600:
        return "a l'instant"
    if seconds < DAY:
        return f"il y a {seconds // 3600} h"
    return f"il y a {seconds // DAY} j"


def read_journal() -> tuple[list[str], "OrderedDict[str, Incident]"]:
    lines: list[str] = []
    incidents: OrderedDict[str, Incident] = OrderedDict()
    try:
        with open(JOURNAL, encoding="utf-8") as handle:
            lines = handle.readlines()
    except FileNotFoundError:
        return [], incidents

    for line in lines:
        parts = line.rstrip("\n").split("\t")
        if len(parts) < 4:
            continue
        try:
            stamp = int(parts[0])
        except ValueError:
            continue
        level, key, title = parts[1], parts[2], parts[3]
        detail = parts[4] if len(parts) > 4 else ""

        incident = incidents.get(key)
        if incident is None:
            incident = Incident(key=key, first_seen=stamp)
            incidents[key] = incident
        incident.count += 1
        incident.first_seen = min(incident.first_seen, stamp)
        # Le libelle du dernier evenement fait foi : c'est lui qui porte l'etat
        # courant ("ancienne de 198 jours" et non "de 30 jours").
        if stamp >= incident.last_seen:
            incident.title = title
            incident.detail = detail
        incident.last_seen = max(incident.last_seen, stamp)
        incident.timestamps.append(stamp)
        if LEVEL_ORDER.get(level, 0) >= LEVEL_ORDER.get(incident.level, 0):
            incident.level = level
    return lines, incidents


def load_json(path: str) -> dict:
    try:
        with open(path, encoding="utf-8") as handle:
            return json.load(handle)
    except (FileNotFoundError, json.JSONDecodeError):
        return {}


def save_json(path: str, payload: dict) -> None:
    temporary = f"{path}.tmp"
    with open(temporary, "w", encoding="utf-8") as handle:
        json.dump(payload, handle)
    os.replace(temporary, path)


def describe(incident: Incident, now: int) -> str:
    """Ligne de contexte : combien de fois, sur quelle duree, quand en dernier."""
    parts = []
    if incident.count > 1:
        days = incident.duration_days
        parts.append(f"{incident.count} fois sur {days} j" if days >= 1 else f"{incident.count} fois")
    parts.append(human_delay(now - incident.last_seen))
    return " · ".join(parts)

def escalate(incidents: dict[str, Incident], now: int) -> bool:
    state = load_json(ESCALATED)
    escalated_now = False

    for incident in incidents.values():
        if incident.level != "warning" or not incident.active(now):
            continue
        if now - incident.first_seen < ESCALATE_AFTER:
            continue

        # Ancien format : un simple horodatage. On le lit encore.
        previous = state.get(incident.key)
        if isinstance(previous, dict):
            last_at, sent = int(previous.get("at", 0)), int(previous.get("count", 0))
        else:
            last_at, sent = int(previous or 0), 1 if previous else 0

        cooldown = min(ESCALATION_COOLDOWN * (2 ** max(sent - 1, 0)), ESCALATION_COOLDOWN_MAX)
        if sent and now - last_at < cooldown:
            continue

        state[incident.key] = {"at": now, "count": sent + 1}
        escalated_now = True
        days = (now - incident.first_seen) // DAY
        lines = [
            f"**Dure depuis {days} jours sans discontinuer.** Une intervention est nécessaire.",
            "",
            f"Signalée {incident.count} fois, la dernière {human_delay(now - incident.last_seen)}.",
        ]
        if incident.detail:
            lines += ["", incident.detail]
        notify("error", incident.title, "\n".join(lines))

    # Les cles resolues n'ont plus a occuper l'etat d'escalade.
    for key in [k for k in state if k not in incidents]:
        del state[key]
    save_json(ESCALATED, state)
    return escalated_now


def digest(incidents: dict[str, Incident], now: int, forced: bool) -> bool:
    try:
        with open(LAST_DIGEST, encoding="utf-8") as handle:
            last = int(handle.read().strip() or 0)
    except (FileNotFoundError, ValueError):
        last = 0

    if not forced and now - last < DIGEST_INTERVAL:
        return False

    active = [i for i in incidents.values() if i.active(now)]
    resolved = [i for i in incidents.values() if not i.active(now)]
    if not active and not resolved:
        # Rien a signaler : on n'envoie rien du tout, et on ne consomme pas
        # l'intervalle -- le prochain incident sera resume sans attendre.
        return False

    # Trie par anciennete : une anomalie installee depuis onze jours prime sur
    # une rafale d'une heure, meme si celle-ci compte plus d'occurrences.
    active.sort(key=lambda i: (LEVEL_ORDER.get(i.level, 0), -i.first_seen), reverse=True)

    lines: list[str] = []
    if active:
        attention = [i for i in active if i.level != "info"]
        pending = [i for i in active if i.level == "info"]

        if attention:
            lines.append("**À regarder**")
            for incident in attention:
                lines.append(f"{LEVEL_MARK.get(incident.level, '·')} **{incident.title}**")
                lines.append(f"　{describe(incident, now)}")
            lines.append("")

        if pending:
            lines.append("**En attente, sans urgence**")
            for incident in pending:
                lines.append(f"· {incident.title}")
            lines.append("")

    if resolved:
        if len(resolved) == 1:
            lines.append("*1 anomalie ne se manifeste plus : considérée comme résolue.*")
        else:
            lines.append(f"*{len(resolved)} anomalies ne se manifestent plus : considérées comme résolues.*")

    if not active:
        lines.append("Rien ne requiert d'action.")

    notify(
        "warning" if any(i.level != "info" for i in active) else "info",
        "Récapitulatif du NAS",
        "\n".join(lines).strip(),
    )
    with open(LAST_DIGEST, "w", encoding="utf-8") as handle:
        handle.write(str(now))
    return True


def compact(lines: list[str], now: int) -> None:
    """Ne conserve que la fenetre utile : le journal ne doit pas croitre sans fin."""
    kept = []
    for line in lines:
        parts = line.split("\t", 1)
        try:
            if now - int(parts[0]) <= JOURNAL_RETENTION:
                kept.append(line)
        except (ValueError, IndexError):
            continue
    if len(kept) != len(lines):
        temporary = f"{JOURNAL}.tmp"
        with open(temporary, "w", encoding="utf-8") as handle:
            handle.writelines(kept)
        os.replace(temporary, JOURNAL)


def main() -> int:
    # Horloge injectable : sans cela le comportement temporel (cooldowns,
    # escalade, intervalle du recapitulatif) ne serait pas testable autrement
    # qu'en attendant des semaines.
    now = int(os.environ.get("NAS_ALERT_NOW") or time.time())
    forced = "--digest" in sys.argv
    os.makedirs(STATE_DIR, exist_ok=True)

    lines, incidents = read_journal()
    escalate(incidents, now)
    digest(incidents, now, forced)
    compact(lines, now)
    return 0


if __name__ == "__main__":
    sys.exit(main())
